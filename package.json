{
  "name": "personal-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next",
    "check:node": "node scripts/check-node-version.mjs",
    "dev": "yarn check:node && next dev",
    "build": "yarn check:node && next build",
    "start": "yarn check:node && next start",
    "lint": "yarn check:node && eslint src --ext .ts,.tsx",
    "typecheck": "yarn check:node && tsc --noEmit"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "24.x"
  },
  "volta": {
    "node": "24.22.1",
    "yarn": "1.22.22"
  },
  "dependencies": {
    "@next/mdx": "15.5.21",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.28",
    "katex": "^0.19.0",
    "mdx": "^0.3.1",
    "next": "15.5.27",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "15.5.21",
    "playwright": "1.55.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
